// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id                      String    @id @default(cuid())
  username                String    @unique
  password                String    // bcrypt 加密存储
  name                    String?   // 显示名称
  securityQuestion        String?   // 安全问题
  securityAnswer          String?   // 安全问题答案（bcrypt 加密存储）
  securityAnswerAttempts  Int       @default(0) // 安全问题答案尝试次数
  securityAnswerLockedAt  DateTime? // 安全问题答案锁定时间
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // 关联数据
  categories      Category[]
  todos           Todo[]
  recurrenceRules RecurrenceRule[]
  apiKeys         ApiKey[]
  inboxItems      InboxItem[]

  @@map("users")
}

// 任务分类
model Category {
  id          String   @id @default(cuid())
  name        String   // 不再全局唯一，改为用户级别唯一
  description String?
  emoji       String?
  color       String?  // 可选颜色标识 (Tailwind class 或 hex)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 用户关联
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  todos Todo[]

  @@unique([userId, name]) // 用户级别唯一
  @@map("categories")
}

// 任务等级（系统级，所有用户共享）
model Level {
  id          String   @id @default(cuid())
  name        String   @unique
  value       Int      @unique // 1-3 的数值（高=3，中=2，低=1）
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  todos       Todo[]

  @@map("levels")
}

// 任务主表
model Todo {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("pending") // pending, in_progress, completed

  // 时间维度（精确到秒，支持提醒功能）
  startDate   DateTime  // 开始时间
  dueDate     DateTime  // 截止时间
  completedAt DateTime? // 完成时间（仅status=completed时有值）

  // 多步骤任务 - 使用 JSON 存储
  subTasks    String?  // JSON 字符串: [{id, text, isDone}]

  // 周期任务
  isCycleTask      Boolean  @default(false)
  recurrenceRuleId String?
  recurrenceRule   RecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id], onDelete: Cascade)
  parentRuleId     String? // 如果是从周期规则生成的任务，记录原规则ID

  // 用户关联
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 分类和等级关联
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  levelId    String?
  level      Level? @relation(fields: [levelId], references: [id], onDelete: SetNull)

  // 元数据
  priority    Int      @default(0) // 排序优先级
  isMilestone Boolean  @default(false) // 季度视图里程碑标记
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // 关联
  reminders Reminder[]

  @@index([userId])
  @@index([startDate])
  @@index([dueDate])
  @@index([status])
  @@index([categoryId])
  @@index([levelId])
  @@map("todos")
}

// 周期规则
model RecurrenceRule {
  id        String   @id @default(cuid())
  frequency String   // DAILY, WEEKLY, MONTHLY, YEARLY, CUSTOM
  interval  Int      @default(1) // 间隔
  byDay     String?  // JSON 数组: [0,1,2,3,4,5,6] 表示周日到周六
  cronExpr  String?  // 自定义 cron 表达式
  startDate DateTime // 开始时间
  endDate   DateTime? // 结束时间（可选）
  isActive  Boolean  @default(true) // 是否激活
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 用户关联
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  todos Todo[]

  @@index([userId])
  @@map("recurrence_rules")
}

// 节假日缓存（系统级，所有用户共享）
model Holiday {
  id        String   @id @default(cuid())
  date      String   @unique // YYYY-MM-DD
  name      String   // 节假日名称
  isHoliday Boolean  // true=休息日, false=工作日（调休）
  year      Int
  createdAt DateTime @default(now())

  @@index([year])
  @@map("holidays")
}

// API 密钥（用于外部程序访问）
model ApiKey {
  id          String    @id @default(cuid())
  name        String    // 密钥名称（如 "Obsidian Plugin"）
  key         String    @unique // 加密存储的 Token（前缀 + 随机字符串）
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime? // 最后使用时间
  expiresAt   DateTime? // 可选：过期时间

  @@index([userId])
  @@index([key])
  @@map("api_keys")
}

// 任务提醒
model Reminder {
  id        String   @id @default(cuid())
  todoId    String
  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)

  remindAt  DateTime // 提醒时间点
  type      String   // "before_due" = 到期前提醒, "custom" = 自定义时间
  offset    Int?     // 提前分钟数（如 120 = 提前2小时，仅 type="before_due" 时有效）
  sent      Boolean  @default(false) // 是否已发送

  createdAt DateTime @default(now())

  @@index([remindAt, sent]) // 查询待发送提醒
  @@index([todoId])
  @@map("reminders")
}

// 捕获箱条目
model InboxItem {
  id               String    @id @default(cuid())
  content          String    // 捕获的文本内容，唯一必填字段
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  convertedToTodoId String?  // 若已转化为任务，记录目标任务 ID
  convertedAt      DateTime? // 转化时间

  @@index([userId, createdAt])
  @@index([userId, convertedToTodoId])
  @@map("inbox_items")
}
