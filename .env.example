# ===========================================
# LifeNexus 环境变量配置模板
# ===========================================
# 复制此文件为 .env.local 并填入实际值

# -------------------------------------------
# 数据库配置 (Supabase PostgreSQL)
# -------------------------------------------
# 从 Supabase 控制台获取:
# Project Settings → Database → Connection string → URI
# 格式: postgresql://postgres.[项目ID]:[密码]@aws-0-[区域].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# 直连 URL（用于迁移，可选）
# 格式: postgresql://postgres:[密码]@db.[项目ID].supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres"

# -------------------------------------------
# Next.js 配置
# -------------------------------------------
# 生产环境设置为 production
NODE_ENV="development"

# -------------------------------------------
# 可选配置
# -------------------------------------------
# NextAuth.js 密钥（如果使用认证功能）
# NEXTAUTH_SECRET="your-secret-key-here"
# NEXTAUTH_URL="http://localhost:3000"